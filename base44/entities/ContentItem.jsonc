{
  "name": "ContentItem",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "description": "Reference to Organization"
    },
    "title": {
      "type": "string",
      "description": "Content title"
    },
    "description": {
      "type": "string",
      "description": "Content description or brief"
    },
    "status": {
      "type": "string",
      "enum": [
        "idea",
        "script",
        "recording",
        "editing",
        "thumbnail",
        "review",
        "scheduled",
        "published"
      ],
      "default": "idea",
      "description": "Current pipeline stage"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "urgent"
      ],
      "default": "medium"
    },
    "assigned_members": {
      "type": "array",
      "description": "Emails of assigned team members",
      "items": {
        "type": "string"
      }
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "description": "Deadline for this content"
    },
    "labels": {
      "type": "array",
      "description": "Tags/labels for categorization",
      "items": {
        "type": "string"
      }
    },
    "youtube_video_id": {
      "type": "string",
      "description": "Linked YouTube video ID"
    },
    "youtube_video_url": {
      "type": "string",
      "description": "Linked YouTube video URL"
    },
    "drive_folder_id": {
      "type": "string",
      "description": "Linked Google Drive folder ID"
    },
    "drive_folder_url": {
      "type": "string",
      "description": "Linked Google Drive folder URL"
    },
    "thumbnail_url": {
      "type": "string",
      "description": "Thumbnail image URL"
    },
    "attachments": {
      "type": "array",
      "description": "File attachment URLs",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        }
      }
    },
    "sort_order": {
      "type": "number",
      "description": "Order within the pipeline stage"
    }
  },
  "required": [
    "organization_id",
    "title",
    "status"
  ]
}