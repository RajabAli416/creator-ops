{
  "name": "ActivityLog",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "description": "Reference to Organization"
    },
    "content_item_id": {
      "type": "string",
      "description": "Reference to ContentItem if applicable"
    },
    "task_id": {
      "type": "string",
      "description": "Reference to Task if applicable"
    },
    "actor_email": {
      "type": "string",
      "description": "Email of user who performed the action"
    },
    "actor_name": {
      "type": "string",
      "description": "Display name of the actor"
    },
    "action": {
      "type": "string",
      "enum": [
        "created",
        "updated",
        "deleted",
        "moved",
        "assigned",
        "commented",
        "uploaded",
        "completed"
      ],
      "description": "Type of action"
    },
    "entity_type": {
      "type": "string",
      "enum": [
        "content",
        "task",
        "member",
        "organization"
      ],
      "description": "What entity was affected"
    },
    "details": {
      "type": "string",
      "description": "Human-readable description of what changed"
    }
  },
  "required": [
    "organization_id",
    "actor_email",
    "action",
    "entity_type",
    "details"
  ]
}