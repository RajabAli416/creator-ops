# Copy to .env.local and fill in your Supabase project values.
# Never commit .env.local — it is gitignored.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# These names also work (Vite loads NEXT_PUBLIC_* via envPrefix):
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public app URL (OAuth redirect). Production: https://your-app.vercel.app
# VITE_APP_URL=http://localhost:5173

# Vercel serverless API only (set in Vercel project env, NOT in the browser):
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# APP_URL=https://your-app.vercel.app

# Local dev: proxy /api to Vercel dev (run `npx vercel dev` on port 3000)
# VITE_API_PROXY=http://127.0.0.1:3000
